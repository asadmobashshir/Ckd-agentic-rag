  "tools": [
    {
      "name": "dosage_lookup",
      "description": "Retrieve stored dosage REFERENCE information for a drug from the curated structured store. Returns reference text only and never computes or suggests a dose for a specific person. Use for general 'what does the reference say' questions, not for patient-specific dosing decisions.",
      "arguments": {
        "additionalProperties": false,
        "properties": {
          "drug": {
            "maxLength": 64,
            "minLength": 2,
            "title": "Drug",
            "type": "string"
          },
          "population": {
            "anyOf": [
              {
                "maxLength": 32,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Population"
          },
          "indication": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Indication"
          }
        },
        "required": [
          "drug"
        ],
        "title": "DosageLookupArgs",
        "type": "object"
      },
      "result_schema": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "structured": {
            "type": "object"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "tool",
          "ok"
        ]
      },
      "requires_network": false,
      "produces_evidence": true
    },
    {
