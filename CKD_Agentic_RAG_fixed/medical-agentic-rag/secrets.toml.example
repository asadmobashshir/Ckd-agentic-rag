# ---------------------------------------------------------------------------
# Streamlit secrets template - PLACEHOLDERS ONLY.
#
# Local use:  copy to .streamlit/secrets.toml and fill in.
# Cloud use:  paste the contents into
#             Manage app -> Settings -> Secrets
#
# .streamlit/secrets.toml is gitignored. NEVER commit a real key.
# TOML rules that actually bite: key and value on ONE line, double quotes,
# and no [section] header above these entries.
# ---------------------------------------------------------------------------

# --- Provider selection ----------------------------------------------------
# "auto" (default) uses whichever key below is set, preferring Groq.
# Force one with "groq" or "gemini".
LLM_PROVIDER = "auto"

# --- Option A: Groq --------------------------------------------------------
# Key: https://console.groq.com/keys
# Model ids are retired regularly - confirm yours is live with
#   python scripts/diagnostics.py --list-models
GROQ_API_KEY = "gsk_replace_with_your_key"
GROQ_MODEL = "llama-3.3-70b-versatile"

# --- Option B: Google Gemini ----------------------------------------------
# Key: https://aistudio.google.com/apikey
# GEMINI_API_KEY = "replace_with_your_key"
# GEMINI_MODEL = "gemini-2.5-flash"

# --- Optional tuning -------------------------------------------------------
# LLM_TEMPERATURE = "0.1"
# LLM_MAX_TOKENS = "1400"
# MAX_AGENT_ITERATIONS = "5"        # ceiling on tool-calling loop turns
# ENABLE_NATIVE_TOOL_CALLING = "true"
# TOP_K = "5"
#
# Set to "hashing" if the free Community Cloud tier runs out of memory loading
# the biomedical embedding model. Retrieval degrades to BM25-led hybrid rather
# than failing, and the status panel says so.
# EMBEDDING_BACKEND = "auto"
