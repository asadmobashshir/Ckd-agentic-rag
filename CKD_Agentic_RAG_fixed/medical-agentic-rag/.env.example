# ---------------------------------------------------------------------------
# Local development environment - PLACEHOLDERS ONLY.
# Copy to .env and fill in. NEVER commit a real key.
# ---------------------------------------------------------------------------

# "auto" uses whichever key is set below, preferring Groq.
LLM_PROVIDER=auto

# --- Option A: Groq (https://console.groq.com/keys) ------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Option B: Google Gemini (https://aistudio.google.com/apikey) ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Generation ------------------------------------------------------------
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1400
LLM_MAX_RETRIES=3

# --- Agent -----------------------------------------------------------------
MAX_AGENT_ITERATIONS=5
ENABLE_NATIVE_TOOL_CALLING=true
MAX_TOOL_ROUNDS=3

# --- Retrieval -------------------------------------------------------------
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=pritamdeka/S-PubMedBert-MS-MARCO
TOP_K=5
MIN_SIMILARITY=0.15

# --- Runtime ---------------------------------------------------------------
LOG_LEVEL=INFO
ENABLE_NETWORK_TOOLS=true

# --- Optional: NCBI / PubMed (raises rate limits) --------------------------
NCBI_EMAIL=
NCBI_API_KEY=
